{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/meta-analysis-bench/analysis-evidence.schema.json",
  "title": "Canonical evidence candidates for meta-analysis selection",
  "type": "object",
  "required": [
    "case_id",
    "candidate_set_id",
    "candidates"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "case_id": {
      "type": "string",
      "pattern": "^ma_[0-9]{4,}$"
    },
    "candidate_set_id": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object"
    },
    "candidates": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "required": [
        "candidate_id",
        "article_id",
        "study_id",
        "target_id",
        "outcome",
        "population_or_subgroup",
        "timepoint",
        "data_family",
        "estimand",
        "effect",
        "raw_data",
        "source_location"
      ],
      "additionalProperties": true,
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "article_id": {
          "type": "string",
          "pattern": "^a_[0-9]{4,}$"
        },
        "study_id": {
          "type": "string",
          "pattern": "^s_[0-9]{4,}$"
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "object"
        },
        "comparison": {
          "type": [
            "string",
            "null"
          ]
        },
        "population_or_subgroup": {
          "type": "string"
        },
        "timepoint": {
          "type": "string"
        },
        "data_family": {
          "type": "string"
        },
        "estimand": {
          "type": "string"
        },
        "effect": {
          "type": [
            "object",
            "null"
          ]
        },
        "raw_data": {
          "type": "object"
        },
        "source_location": {
          "type": "object"
        }
      }
    }
  }
}
