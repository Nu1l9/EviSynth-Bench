{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/meta-analysis-bench/analysis-profile.schema.json",
  "title": "Meta-analysis selection and synthesis profile",
  "type": "object",
  "required": [
    "case_id",
    "analysis_profile_id",
    "analyses"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "case_id": {
      "type": "string",
      "pattern": "^ma_[0-9]{4,}$"
    },
    "analysis_profile_id": {
      "type": "string",
      "minLength": 1
    },
    "analyses": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/analysis"
      }
    }
  },
  "$defs": {
    "analysis": {
      "type": "object",
      "required": [
        "analysis_id",
        "outcome_group",
        "target_id",
        "eligible_data_families",
        "accepted_effect_types",
        "selection_rules",
        "pooling"
      ],
      "additionalProperties": false,
      "properties": {
        "analysis_id": {
          "type": "string",
          "minLength": 1
        },
        "pooled_result_id": {
          "type": "string",
          "minLength": 1
        },
        "outcome_group": {
          "type": "string",
          "minLength": 1
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "eligible_outcome_codes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "eligible_data_families": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "accepted_effect_types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "estimands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "selection_rules": {
          "type": "object",
          "required": [
            "one_effect_per_study",
            "rules"
          ],
          "additionalProperties": false,
          "properties": {
            "one_effect_per_study": {
              "type": "boolean"
            },
            "rules": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "pooling": {
          "type": "object",
          "required": [
            "model",
            "scale",
            "minimum_independent_studies"
          ],
          "additionalProperties": false,
          "properties": {
            "model": {
              "enum": [
                "fixed_effect",
                "random_effects"
              ]
            },
            "scale": {
              "type": "string",
              "minLength": 1
            },
            "heterogeneity_estimator": {
              "type": [
                "string",
                "null"
              ]
            },
            "minimum_independent_studies": {
              "type": "integer",
              "minimum": 2
            }
          }
        }
      }
    }
  }
}
